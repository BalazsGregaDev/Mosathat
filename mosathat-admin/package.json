{
  "name": "mosathat-admin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "oxlint && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "db:link": "supabase link --workdir ..",
    "db:push": "supabase db push --workdir ..",
    "db:status": "supabase migration list --workdir ..",
    "db:types": "supabase gen types typescript --linked --workdir .. > src/lib/database.types.ts",
    "fn:deploy": "supabase functions deploy --workdir .."
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/bodoni-moda": "^5.3.0",
    "@fontsource-variable/jost": "^5.3.0",
    "@fontsource-variable/karla": "^5.3.0",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/courier-prime": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/spectral": "^5.3.0",
    "@supabase/supabase-js": "^2.47.10",
    "docx": "^9.8.1",
    "jszip": "3.10.2",
    "mammoth": "1.12.3",
    "qrcode": "1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/qrcode": "1.5.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "oxlint": "^1.85.0",
    "supabase": "^2.117.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
