# ---------------------------------------------------------------------------
# Melyik adatforrás fut.
#
#   demo      – PGlite: valódi PostgreSQL a böngészőben, a supabase/migrations
#               mappa NÉGY migrációjával. Ugyanaz a calc_service(), ugyanazok
#               a nézetek. Nem kell hozzá se fiók, se internet.
#               Figyelem: az adat a lap újratöltésekor elveszik.
#
#   supabase  – az éles adatbázis. Ehhez kell a két alábbi érték.
# ---------------------------------------------------------------------------
VITE_DATA_SOURCE=demo

# Supabase → Project Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
